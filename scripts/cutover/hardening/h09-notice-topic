#!/bin/bash
# Hardening's test 9: a Notice topic at a private address, or behind a
# redirect, is refused (spec section 16, Ready item 8; section 12 "Notices";
# section 13 "Notices").
#
#   h09-notice-topic [--dry-run | --local | --lab --volunteers-mac NAME --redirect URL] [--records DIR]
#
#   --volunteers-mac NAME  through the Lab address: a Volunteer's Mac of the
#                          lab whose Volunteer is at it (the M2 Max in step
#                          14a, decision S12): there is none other in Preview
#   --redirect URL         an https address on the public internet that
#                          answers with a redirect to a private address
#
# labd checks a Volunteer's own topic when the Mac reports it and each time
# it sends: https only, a public address, judged on the address it connects
# to, no redirect followed. A refused topic is shown on My Macs and the
# Notice is dropped. Locally a Volunteer's simulated Mac reports a topic on
# this machine's loopback, where a port counts who connects; a Maintainer
# then ends the Mac's enrollment, which sends its Volunteer a Notice: nothing
# may connect. The redirect needs a public address, so it is tried through
# the Lab address only, where the owner sets each topic at the Mac and the
# test reads the Mac's card: a redirect is found only when a Notice is sent,
# so a job is started for its Notice and canceled before the Mac reboots.
set -euo pipefail
# shellcheck source=scripts/cutover/hardening/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
usage() { sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

hd_options "$@"
volunteers="" redirect=""
set -- ${REST[@]+"${REST[@]}"}
while (( $# )); do
  case "$1" in
    --volunteers-mac) (( $# >= 2 )) && [[ $2 =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || fail "--volunteers-mac needs a Mac's name"; volunteers="$2"; shift ;;
    --redirect) (( $# >= 2 )) && [[ $2 =~ ^https://[A-Za-z0-9.-]+(/[^[:space:]]*)?$ ]] || fail "--redirect needs an https address"; redirect="$2"; shift ;;
    *) fail "an option it does not take: $1. Nothing was done." ;;
  esac
  shift
done

# Where lab-agent keeps a Volunteer's Notice settings at the Mac, and where
# the test copies them aside (see notices below). Each command stops at its
# first step that fails: the copy aside goes only once every setting is
# back.
agent_dir=/var/lib/maclab
saved_dir=/var/lib/maclab-h09
save_settings="sudo sh -c 'set -e; mkdir -m 700 $saved_dir; for f in ntfy-topic ntfy-jobs; do [ ! -e $agent_dir/\$f ] || cp -p $agent_dir/\$f $saved_dir/; done'"
put_back="sudo sh -c 'set -e; cd $saved_dir; for f in ntfy-topic ntfy-jobs; do if [ -e \$f ]; then cp -p \$f $agent_dir/; else rm -f $agent_dir/\$f; fi; done; cd /; rm -r $saved_dir'"

if [[ $MODE == dry ]]; then
  cat <<PLAN
$ME: dry run. Through $ADDRESS, with the Volunteer of ${volunteers:-NAME} at the Mac and the owner's browser (the session cookie typed at a hidden prompt), it would:
  1. read ${volunteers:-NAME}'s card on My Macs: the topic and the job Notices it shows, kept in the run's folder and never shown
  2. STOP, by hand: at ${volunteers:-NAME}, copy its Notice settings aside, as root: $save_settings
  3. STOP, by hand: at ${volunteers:-NAME}, run: sudo lab-agent notify --topic https://192.168.0.1/h09
  4. read ${volunteers:-NAME}'s card on My Macs (for M team, Mine on Macs at $ADDRESS/macs?show=mine)
     expects: the topic shown as refused (not a public address)
  5. STOP, by hand: at ${volunteers:-NAME}, run: sudo lab-agent notify --topic ${redirect:-URL}, then: sudo lab-agent notify --jobs on
  6. run: lab run ${volunteers:-NAME} --no-wait under a holder of the run's own, armed for lab cancel by it first, for the Notice that a job is starting; read the card; lab cancel the job before the Mac reboots
     expects: the topic shown as refused (a redirect is not followed); the topic got no Notice
  7. STOP, by hand: at ${volunteers:-NAME}, put its Notice settings back, as root: $put_back
     expects: the card shows the topic and the job Notices of step 1 again; what does not come back the record names NOT UNDONE (labd keeps the last topic a Mac reported: a Mac with no topic of its own does not get the lab's back)
  8. write docs/acceptance/$(today)-hardening-09.md and its line in docs/acceptance/$RESULTS_NAME
Locally: a Volunteer's simulated Mac reports a topic on this machine's loopback, a Maintainer ends its enrollment,
     expects: nothing connects to the topic's port; the Notice is dropped
Nothing was sent.
PLAN
  exit 0
fi
[[ $MODE != lab || ( -n $volunteers && -n $redirect ) ]] || fail "--lab needs --volunteers-mac NAME and --redirect URL: the test sets topics at a Volunteer's Mac, and Preview has one only in step 14a. Nothing was done."

# rule_broken WHY: the rule did not hold.
rule_broken() {
  if [[ -n ${WAITS_FOR:-} ]]; then waits_for "$WAITS_FOR" "$1"; fi
  give_up "$1"
}

# before_lab: a stand-in for the lab's own notice server, where the topics
# labd makes for Volunteers' Macs are: the control, which a Notice does reach.
# shellcheck disable=SC2329
before_lab() {
  "$PROBE" listen > "$WORK/control.out" 2>&1 &
  PIDS+=($!)
  wait_until 10 grep -q '^port=' "$WORK/control.out" || fail "the stand-in for the notice server did not start"
  LOCAL_FLAGS+=("--ntfy=http://127.0.0.1:$(sed -n 's/^port=//p' "$WORK/control.out")")
}
# stored KEY: what labd keeps on the loaner's record.
stored() { sqlite3 "file:$LOCAL_DATA/labd.db?mode=ro" "SELECT json_extract(data, '\$.$1') FROM devices WHERE name = $(sql_text "$volunteers")" 2>/dev/null | head -n 1; }
# shellcheck disable=SC2329
topic_refused() { [[ "$(stored ntfy_own_url)" == "$topic" && -n "$(stored notice_topic_refused)" ]]; }
reached() { grep -c '^connection=' "$WORK/$1.out" || true; }
# shellcheck disable=SC2329
control_reached() { (( $(reached control) > 0 )); }

begin 09 "a Notice topic at a private address, or behind a redirect, is refused"
if playing; then
  people
  volunteers=loaner
  volunteer_mac "$volunteers"
  rec "@lender lends $volunteers, a Volunteer's simulated Mac that Joined by the Join command"
  "$PROBE" listen > "$WORK/listen.out" 2>&1 &
  PIDS+=($!)
  wait_until 10 grep -q '^port=' "$WORK/listen.out" || fail "the counting port did not start"
  port="$(sed -n 's/^port=//p' "$WORK/listen.out")"
  dir="$(sim_dir "$volunteers")" || fail "no folder for the simulated $volunteers"
  # What sudo lab-agent notify --topic writes at the Mac.
  topic="https://127.0.0.1:$port/h09"
  echo "$topic" > "$dir/ntfy-topic"
  rec "$volunteers reports its own topic, https://127.0.0.1:PORT/h09, on this machine's loopback"
  wait_until 30 topic_refused || rule_broken "labd did not keep $volunteers's topic as refused: it keeps $( [[ "$(stored ntfy_own_url)" == "$topic" ]] && echo "the topic" || echo "another topic or none"), refused: $(stored notice_topic_refused)"
  rec "labd keeps that topic and refuses it: $(stored notice_topic_refused)"

  # The control: a second Mac of the lender's with no topic of its own.
  form join2 --session "$WORK/lender.session" --page /lend /lend/join-command model=j314s name=control
  token="$( { grep -oE 'enr_[0-9a-f]{32}' "$WORK/join2.body" || true; } | head -n 1)"
  rm -f "$WORK/join2.body"
  [[ -n $token ]] || fail "Lend a Mac showed the lender no second Join command: $(status_of join2) $(said_of join2)"
  sim_mac control "$token"
  "$LAB_CMD" remove control > "$WORK/remove-control.out" 2>&1 || give_up "lab remove control: $(plain "$WORK/remove-control.out")"
  wait_until 20 control_reached || give_up "labd sent no Notice when control's enrollment was ended: nothing here proves a Notice would have gone"
  rec "a Maintainer ended control's enrollment, a Mac of @lender's with no topic of its own: control's Notice reached the stand-in for the lab's notice server"
  before="$(reached control)"

  "$LAB_CMD" remove "$volunteers" > "$WORK/remove.out" 2>&1 || give_up "lab remove $volunteers: $(plain "$WORK/remove.out")"
  rec "a Maintainer ended $volunteers's enrollment, which sends its Volunteer a Notice"
  sleep 5
  connections="$(reached listen)"
  [[ $connections == 0 ]] || rule_broken "labd connected $connections time(s) to the Volunteer's topic at a private address (this machine's loopback)"
  [[ "$(reached control)" == "$before" ]] || rule_broken "the Notice for $volunteers went to the lab's notice server in place of its refused topic"
  rec "nothing connected to the topic's port, nor to the lab's notice server: the Notice was dropped"
  rec "the redirect is tried through the Lab address only: it needs a public address"
  passed
fi

# The Mac's card, as the owner's browser reads My Macs: for an M team
# member or a Maintainer it is Mine on Macs, where /my-macs sends them.
WAIT="${H09_WAIT:-120}"
# shellcheck disable=SC2329
card() {
  local loc
  "$PROBE" page --session "$OWNER_SESSION" --out "$WORK/my-macs.html" /my-macs > "$WORK/my-macs.out" 2>&1 || true
  if grep -qx 'status=303' "$WORK/my-macs.out"; then
    loc="$(fact my-macs location)"
    [[ $loc == /* ]] || give_up "My Macs sent the browser to $loc"
    "$PROBE" page --session "$OWNER_SESSION" --out "$WORK/my-macs.html" "$loc" > "$WORK/my-macs.out" 2>&1 || true
  fi
  grep -qx 'status=200' "$WORK/my-macs.out" || give_up "My Macs did not open: $(tr '\n' ' ' < "$WORK/my-macs.out")"
  awk -v id="id=\"mac-$volunteers\"" 'index($0, id) { on = 1 } on && /<section class="card/ && !index($0, id) { exit } on { print }' "$WORK/my-macs.html" > "$WORK/card.html"
  [[ -s $WORK/card.html ]] || give_up "My Macs shows no card for $volunteers"
}
# refusal: what the Mac's card says of its topic's refusal, or nothing.
refusal() { grep -o 'Your own topic is refused: [^<]*' "$WORK/card.html" | head -n 1 || true; }
# shellcheck disable=SC2329
refused_with() { card; refusal | grep -qF -- "$1"; }
# shellcheck disable=SC2329
not_refused_with() { card; ! refusal | grep -qF -- "$1"; }

# The Mac's Notice settings, its own topic and its job Notices, are two files
# at the Mac, set by hand there, and only there put back. Before the test
# changes them they are copied aside as root at the Mac, and copied back at
# its end (a file the Mac did not have is removed again); the Mac's card is
# read before and after, to see them back. The card shows the topic, the
# Mac's only secret: it is kept in the run's own folder and never shown.
# labd keeps the last topic a Mac reported, so a Mac that had none of its
# own, and so the lab's, does not get the lab's back: the record says so.
# notices: the topic and the job Notices the Mac's card shows, a line each.
notices() {
  card
  grep -oE '<dt>Notices</dt><dd>(<span class="copyable"><code data-copy>[^<]*</code>|<span class="dim">no topic</span>)' "$WORK/card.html" | head -n 1 || true
  grep -oE 'job Notices o(n|ff)' "$WORK/card.html" | head -n 1 || true
}
# shellcheck disable=SC2329
notices_back() { notices > "$WORK/notices.after"; cmp -s "$WORK/notices.before" "$WORK/notices.after"; }
# shellcheck disable=SC2329
undo_topic() {
  rec "NOT UNDONE: $volunteers's topic and job Notices are still the test's: at $volunteers, put them back: $put_back"
}
# The job is asked for under a holder of the run's own, its tag, and armed by
# that tag before it is asked for: an answer that is lost, or a Ctrl-C before
# its id is read, still leaves no job of the run's on the Mac.
# tagged_jobs TAG: of the jobs labd listed (JSON on stdin), the ids of those
# asked for under TAG that have not ended.
# shellcheck disable=SC2329
tagged_jobs() {
  sed 's/"id":"j/\
"id":"j/g' | awk -v want="\"holder\":\"$1\"" 'index($0, want) && !index($0, "\"state\":\"done\"") && match($0, /^"id":"j[0-9a-z-]*"/) { print substr($0, 7, RLENGTH - 7) }'
}
# shellcheck disable=SC2329
undo_job() {
  local ids id said
  "$PROBE" ask --out "$WORK/jobs.json" GET "/api/jobs?device=$volunteers&limit=50" > "$WORK/jobs.out" 2>&1 || true
  if ! grep -qx 'status=200' "$WORK/jobs.out"; then
    said="$(fact jobs status)"
    rec "NOT UNDONE: a job of the run's on $volunteers may still run: the lab did not list the Mac's jobs (${said:-no answer}): lab jobs $volunteers, and lab cancel the one it started"
    return 0
  fi
  ids="$(tagged_jobs "$1" < "$WORK/jobs.json")"
  if [[ -z $ids ]]; then
    rec "undone: no job of the run's is left on $volunteers"
    return 0
  fi
  for id in $ids; do
    if "$LAB_CMD" cancel "$id" > "$WORK/undo-job.out" 2>&1; then
      rec "undone: job $id on $volunteers was canceled"
    else
      rec "NOT UNDONE: job $id on $volunteers may still run: lab cancel $id ($(plain "$WORK/undo-job.out"))"
    fi
  done
}

owner_session
notices > "$WORK/notices.before"
[[ "$(wc -l < "$WORK/notices.before" | tr -d ' ')" == 2 ]] || give_up "$volunteers's card on My Macs does not show its topic and job Notices: the test could not see them put back"
hands "At $volunteers, copy its Notice settings aside, as root (if it says the folder exists, an earlier run's copy is there: put that back first with: $put_back): $save_settings"
arm topic undo_topic
hands "At $volunteers, run: sudo lab-agent notify --topic https://192.168.0.1/h09"
wait_until "$WAIT" refused_with "not a public address" || rule_broken "$volunteers's card does not show the topic at a private address refused"
rec "the topic at a private address: $volunteers's card says: $(refusal)"

# Behind a redirect the topic passes when the Mac reports it: only a Notice
# finds the redirect. A job's Notice that it is starting is sent before the
# Mac shows its Volunteer the reboot warning, and the job is canceled then.
hands "At $volunteers, run: sudo lab-agent notify --topic $redirect, then: sudo lab-agent notify --jobs on"
confirm "The test now starts a job on $volunteers for its Notice that a job is starting, and cancels it before the Mac reboots for it. Go on?" \
  || stopped "the topic behind a redirect needs a job's Notice, and none was made"
"$LAB_CMD" status "$volunteers" > "$WORK/mac.out" 2>&1 || give_up "lab status $volunteers: $(plain "$WORK/mac.out")"
! grep -q '^  lease:' "$WORK/mac.out" || stopped "somebody holds a Lease on $volunteers now: run this when it is free"
wait_until "$WAIT" not_refused_with "not a public address" || give_up "$volunteers did not report the topic behind a redirect: its card still says $(refusal)"
job_tag="$MACLAB_HOLDER-h09-$(nonce)"
arm job undo_job "$job_tag"
MACLAB_HOLDER="$job_tag" "$LAB_CMD" run "$volunteers" --no-wait > "$WORK/job.out" 2>&1 || give_up "no job on $volunteers: $(plain "$WORK/job.out")"
job="$(sed -n 's/^job \([^ ]*\) queued on .*/\1/p' "$WORK/job.out" | head -n 1)"
[[ -n $job ]] || give_up "lab run named no job: $(plain "$WORK/job.out")"
wait_until "$WAIT" refused_with "redirect" || rule_broken "$volunteers's card does not show the topic behind a redirect refused, after job $job's Notice"
"$LAB_CMD" cancel "$job" > "$WORK/cancel.out" 2>&1 || give_up "job $job was not canceled: $(plain "$WORK/cancel.out")"
disarm job
rec "job $job on $volunteers made a Notice to the topic behind a redirect, and was canceled"
rec "the topic behind a redirect: $volunteers's card says: $(refusal)"
confirm "Did that topic, or the address it sends to, get no Notice from the lab?" || rule_broken "the topic behind a redirect got a Notice"
hands "At $volunteers, put its Notice settings back, as root: $put_back"
disarm topic
if wait_until "$WAIT" notices_back; then
  rec "undone: $volunteers's topic and job Notices are as they were before the test, as its card shows"
else
  [[ "$(sed -n 1p "$WORK/notices.before")" == "$(sed -n 1p "$WORK/notices.after")" ]] \
    || rec "NOT UNDONE: $volunteers's Notices still go to another topic than before the test, as its card shows. If the Mac had no topic of its own before, labd keeps the last one it reported: the lab's own topic cannot be given back from the Mac, and the Volunteer sets one with sudo lab-agent notify --topic URL. Otherwise, at $volunteers: $put_back"
  [[ "$(sed -n 2p "$WORK/notices.before")" == "$(sed -n 2p "$WORK/notices.after")" ]] \
    || rec "NOT UNDONE: $volunteers's job Notices are $(sed -n 2p "$WORK/notices.after" | sed 's/^job Notices //') and were $(sed -n 2p "$WORK/notices.before" | sed 's/^job Notices //') before the test: at $volunteers, sudo lab-agent notify --jobs $(sed -n 2p "$WORK/notices.before" | sed 's/^job Notices //')"
fi
passed
