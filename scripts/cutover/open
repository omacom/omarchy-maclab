#!/bin/bash
# The opening, on the mini (the Cutover's step 25; spec section 16). With
# sudo:
#
#   sudo open [--dry-run] --m-team N [--imported YYYY-MM-DD]
#   sudo open stage
#
# It is the point of no return. In one step labd accepts reports and Mac
# sign-in, takes Preview's banner and noindex off, says on the home page for
# 30 days that omarchy-m-testing.org is now here, and serves the latest Lab
# release from its install lines. labd is not restarted and nothing is
# Deployed: the lab opens on the Release candidate it runs. Nothing puts an
# open lab back into Preview.
#
# It refuses, and changes nothing, unless all of this is true first:
#   - a Lab release is Deployed, labd runs and its ops socket is there;
#   - the lab is in Preview;
#   - the day's import ran and its three checks passed today
#     (rehearsal-import run): the reports the lab opens with are the old
#     site's after the Freeze, not a rehearsal's copy. --imported names
#     another day when the import ran before midnight;
#   - labd counts exactly N people marked M team on People (the 14 of step
#     24), has its machine-id key and an OAuth app to sign people in with.
# labd itself checks the last line, and says which part is not so.
#
# Run again on an open lab it changes nothing and says when the lab opened.
#
#   --dry-run  say what would be checked and asked, and change nothing
#   stage      only say where the lab is: preview, or live and since when
#
# The edge's cache, the old name's redirect and the release's tag are not
# the mini's: scripts/cutover/day asks for them on the owner's Mac.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/cutover/mini.sh
. "$here/mini.sh"

usage() { sed -n '2,33p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

only_stage=0
m_team=""
imported=""
while (( $# )); do
  case "$1" in
    stage) only_stage=1 ;;
    --dry-run) DRY=1 ;;
    --m-team) [[ $# -ge 2 ]] || usage; m_team="$2"; shift ;;
    --imported) [[ $# -ge 2 ]] || usage; imported="$2"; shift ;;
    *) echo "$ME: an argument it does not take. Nothing was done." >&2; usage ;;
  esac
  shift
done

mark="$LAB_HOME/import/imported"

if (( only_stage )); then
  if [[ -n $m_team$imported ]] || (( DRY )); then usage; fi
  need_root
  deployed
  lab_stage
  exit 0
fi

[[ $m_team =~ ^[0-9]{1,3}$ ]] || usage
[[ -z $imported || $imported =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage
today="$(TZ=Australia/Brisbane date +%Y-%m-%d)"
want_day="${imported:-$today}"

if (( DRY )); then
  say "would check: a Lab release is Deployed, labd runs with its ops socket at $OPS_SOCKET, the lab is in Preview"
  say "would check: $mark says the day's import and its three checks passed on $want_day"
  say "would ask labd on its ops socket to open the lab: POST /open?m-team=$m_team. labd refuses unless exactly $m_team people are marked M team, it has its machine-id key and an OAuth app"
  say "would then be Live, with no way back: reports and Mac sign-in accepted, Preview's banner and noindex off, \"omarchy-m-testing.org is now here\" on the home page for 30 days, the install lines serving the latest Lab release"
  say "nothing was changed"
  exit 0
fi

need_root
deployed
no_planted_link
# From the stage and the import's mark to labd's answer: the import never
# empties the reports in between.
hold_lab
is="$(lab_stage)"
case "$is" in
  "live "*)
    say "the lab is open already ($is): nothing was changed"
    exit 0
    ;;
  open) fail "labd's LaunchDaemon file starts it without --preview: this lab never was in Preview, and there is nothing to open" ;;
  unknown) fail "labd could not say whether the lab has opened ($LABD stage --data $LAB_DATA): the Deployed Lab release may be older than the opening. Nothing was changed" ;;
esac
loaded "$LABD_LABEL" || fail "labd is not running: start it first (launchctl bootstrap system $LABD_PLIST). Nothing was changed"
[[ -S $OPS_SOCKET ]] || fail "labd's ops socket is not at $OPS_SOCKET. Nothing was changed"
no_link "$mark"
day="$(as_lab cat "$mark" 2>/dev/null | head -n 1)" || day=""
[[ -n $day ]] || fail "the day's import has not run: there is no $mark. Step 22 first (rehearsal-import run). Nothing was changed"
[[ $day == "$want_day" ]] || fail "the last import that passed its checks ran on $day, not $want_day: the lab would open with a copy from before the Freeze. Run the day's import first, or name that day with --imported $day if it is the day's. Nothing was changed"

# The answer comes back on curl's output: curl runs as lab, which cannot
# write a file root made.
said="$(as_lab curl -sS --max-time 30 -w '\n%{http_code}' --unix-socket "$OPS_SOCKET" -X POST "http://labd/open?m-team=$m_team" 2>/dev/null)" ||
  fail "labd did not answer on $OPS_SOCKET. Ask where the lab is before anything else: sudo $0 stage"
status="${said##*$'\n'}"
answer="$(printf '%s\n' "${said%$'\n'*}" | head -n 1 | tr -d '\r')"
case "$status" in
  200) ;;
  409 | 400) fail "labd did not open the lab: $answer. Nothing was changed" ;;
  404) fail "the labd that runs has no opening: Deploy the Release candidate that has it. Nothing was changed" ;;
  *) fail "labd answered $status to the opening. Ask where the lab is before anything else: sudo $0 stage" ;;
esac
[[ $answer == "live "* ]] || fail "labd answered the opening with something else than the time it opened. Ask where the lab is: sudo $0 stage"
[[ "$(lab_stage)" == "$answer" ]] || fail "labd says the lab opened ($answer) and its data directory does not hold it. Ask again: sudo $0 stage"
say "the lab is open: $answer. This is the point of no return"
say "reports and Mac sign-in are accepted; Preview's banner and noindex are off; the home page names omarchy-m-testing.org for 30 days; the install lines serve the latest Lab release"
