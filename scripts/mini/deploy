#!/bin/bash
# Deploy a Lab release on the mini:
#
#   sudo scripts/mini/deploy [--dry-run] [--from URL] [--wait MINUTES] vX.Y.Z[-rc.N]
#
# In this order:
#
#   1. downloads the server bundle and its .sig and checks it against the
#      release key pinned on the mini;
#   2. unpacks it beside the running build;
#   3. says so in "Agents" and drains jobs: labd starts no further job, and
#      the Deploy waits until those that run have ended;
#   4. stops labd and copies both databases as they are then;
#   5. switches to the build and restarts the lab's services, never the
#      mini: labd, and the Out-of-band controller and the Builder where the
#      set-up has started them; a controller the set-up installed but could
#      not start yet, with no build to run it from, is started;
#   6. verifies labd on this machine and, once the tunnel is installed here,
#      through the Front door; and that the Builder asks labd for work and
#      the Out-of-band controller answers it;
#   7. reports in "Agents", and says to run the set-up when the build names
#      other images for the Builder than those it runs: the set-up builds
#      them, which takes a while, and starts the Builder with them.
#
# When the check fails it Deploys the previous version by itself; with none
# before it, labd and the controller, loaded here or at boot, stay stopped. Going back
# from a release that says "No way back." (its build carries
# deploy/no-way-back) also puts the databases back as step 4 copied them:
# what arrived since is lost. So does a Deploy of an older version over a
# running release that says it: the databases go back as they were before
# that release, after step 4. The last three builds are kept. It names an
# exact version: never "latest". It touches no tool and never calls
# Homebrew: tools, container and macOS change in a Maintenance run; the
# tunnel is restarted only when the build brings other routes. Needs only
# what macOS has.
#
#   --dry-run       download and check the bundle, then say what would change
#   --from URL      where the two files are, instead of that tag's GitHub
#                   Release: https://..., or file:///a/folder on this machine
#   --wait MINUTES  how long to wait for running jobs to end (30). After
#                   that the Deploy stops, with nothing switched
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/mini/lib.sh
. "$here/lib.sh"

usage() { sed -n '2,41p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

from=""
tag=""
wait=30
while (( $# )); do
  case "$1" in
    --dry-run) DRY=1 ;;
    --from) [[ $# -ge 2 ]] || usage; from="$2"; shift ;;
    --wait) [[ $# -ge 2 && $2 =~ ^[0-9]{1,4}$ ]] || usage; wait="$2"; shift ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) [[ -z $tag ]] || usage; tag="$1" ;;
  esac
  shift
done
[[ $tag != latest ]] || fail 'name an exact version, such as v0.2.0 or v0.2.0-rc.1: "latest" is never Deployed'
[[ $tag =~ $RELEASE_TAG ]] || fail "\"$tag\" is not a Lab release's tag: vX.Y.Z or vX.Y.Z-rc.N"
from="${from:-$RELEASE_URL/$tag}"
(( DRY )) || need_root
[[ -s $LAB_SIGNERS ]] || fail "no release key is pinned at $LAB_SIGNERS: run scripts/mini/setup --release-key FILE first"

plist="$LAUNCHD_DIR/$LABD_LABEL.plist"
work="$(mktemp -d "${TMPDIR:-/tmp}/lab-deploy.XXXXXX")"
lock=""
stage=""
previous=""
# Set once "Agents" was told the Deploy started: whatever ends it is told too.
announced=0
# Set while labd is stopped for a switch whose check has not passed: an exit
# then, whatever failed, puts the previous build back.
switching=0
# Set once this Deploy, of an older version over a release that says "No
# way back.", began to put the databases back: going back from it puts the
# marked release's own databases back too.
went_back=0
# Set when Litestream ran as the Deploy began.
litestream_ran=0
# shellcheck disable=SC2317,SC2329
cleanup() {
  local status=$? name
  trap - EXIT
  if (( switching )); then
    say "the Deploy of $tag stopped part-way (exit $status)"
    (set +e; way_back) || true
  elif (( status && announced )); then
    (set +e; lift_drain; rm -rf "${LAB_BUILDS:?}/$tag"; tell "Deploy of $tag on the mini stopped before anything was switched: ${previous:-nothing} runs as before.") || true
  fi
  (set +e; lift_drain) || true
  # A copy put beside a database and never renamed into place goes, whatever
  # stopped the restore: it is a whole database the backup would carry.
  if [[ -n $lock ]]; then
    for name in $LAB_DATABASES; do
      [[ ! -e $LAB_DATA/$name.restored && ! -L $LAB_DATA/$name.restored ]] || (set +e; as_lab rm -f "$LAB_DATA/$name.restored") || true
    done
  fi
  # However it ended, a restore stopped part-way leaves Litestream as the
  # Deploy found it. One that does not run again fails the Deploy: the
  # databases are not replicated.
  if ! (set +e; litestream_up); then
    status=1
    (set +e; tell "Litestream did not start again after the Deploy of $tag on the mini: the databases are not replicated until it runs (sudo launchctl bootstrap system $LAUNCHD_DIR/$LITESTREAM_LABEL.plist).") || true
    echo "$ME: Litestream did not start again: the databases are not replicated until it runs. Start it: sudo launchctl bootstrap system $LAUNCHD_DIR/$LITESTREAM_LABEL.plist" >&2
  fi
  rm -rf "$work"
  [[ -z $stage ]] || rm -rf "$stage"
  [[ -z $lock ]] || rmdir "$lock" 2>/dev/null || true
  exit "$status"
}
trap cleanup EXIT
# A Deploy cut off (the owner's terminal closes, Ctrl-C, a kill) exits
# through cleanup by a trap of its own: left to bash, a signal taken while it
# waits on a command around the switch can end it with no EXIT trap run, and
# cleanup read the last command's 0 as the status.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# running: the tag of the build labd runs from, or nothing.
running() {
  if [[ -L $LAB_CURRENT ]]; then basename "$(readlink "$LAB_CURRENT")"; fi
}

stop_labd() { stopped "$LABD_LABEL" || fail "labd did not stop (20 s): nothing was switched"; }

# The tunnel is installed on this machine once the set-up has put
# cloudflared's LaunchDaemon file in place. Before that, as at the first
# Deploy, the Front door does not answer and is not asked.
tunnel_installed() { [[ -f $LAUNCHD_DIR/$CLOUDFLARED_LABEL.plist ]]; }

# snapshot: both databases, whole, as they are with labd stopped, in a
# folder of the version about to be Deployed. The lab account makes it.
snapshot() {
  local dir="$BEFORE_DEPLOY/$tag" name
  no_link "$BEFORE_DEPLOY" "$dir"
  lab_folder "$BEFORE_DEPLOY" 700
  as_lab rm -rf "${dir:?}"
  lab_folder "$dir" 700
  for name in $LAB_DATABASES; do
    if [[ ! -f $LAB_DATA/$name ]]; then
      say "there is no $name yet to copy"
      continue
    fi
    no_link "$LAB_DATA/$name" "$dir/$name"
    { as_lab sqlite3 "$LAB_DATA/$name" ".timeout 5000" "VACUUM INTO '$dir/$name'" >/dev/null 2>&1 &&
      [[ "$(as_lab sqlite3 "$dir/$name" 'PRAGMA integrity_check' 2>/dev/null)" == ok ]]; } ||
      fail "$name could not be copied to $dir before the switch"
    say "copied $name to $dir"
  done
}

# litestream_down [WHY]: Litestream has let go of the databases, or nothing
# is put back under it; WHY is said then.
# shellcheck disable=SC2317,SC2329
litestream_down() {
  stopped "$LITESTREAM_LABEL" || fail "Litestream did not stop (20 s), so no database was put back${1:+: $1}"
}

# litestream_up: Litestream runs again if it ran when the Deploy began;
# false when launchd does not have it loaded after that.
# shellcheck disable=SC2317,SC2329
litestream_up() {
  (( litestream_ran )) || return 0
  loaded "$LITESTREAM_LABEL" || launchctl bootstrap system "$LAUNCHD_DIR/$LITESTREAM_LABEL.plist" || true
  loaded "$LITESTREAM_LABEL" || { say "launchd did not start Litestream again"; return 1; }
}

# restore_beside BUILD [WHY]: the databases as they were before the Deploy
# of BUILD, copied beside the ones in use, with Litestream stopped. Nothing
# in use changes here: when a copy fails, a disk that fills among them, the
# copies go and it fails, saying WHY.
# shellcheck disable=SC2317,SC2329
restore_beside() {
  local dir="$BEFORE_DEPLOY/$1" name n
  no_link "$BEFORE_DEPLOY" "$dir"
  for name in $LAB_DATABASES; do no_link "$LAB_DATA/$name" "$LAB_DATA/$name.restored" "$dir/$name"; done
  litestream_down "${2:-}"
  for name in $LAB_DATABASES; do
    as_lab rm -f "$LAB_DATA/$name.restored"
    [[ -f $dir/$name ]] || continue
    if ! as_lab cp "$dir/$name" "$LAB_DATA/$name.restored"; then
      for n in $LAB_DATABASES; do as_lab rm -f "$LAB_DATA/$n.restored"; done
      fail "$name could not be copied beside the databases from $dir, so none was put back${2:+: $2}"
    fi
  done
}

# into_place FROM NAME: FROM, a whole database, is NAME of the lab's data by
# a rename, which needs no room, with nothing kept of the one it replaces:
# its WAL, its SHM, Litestream's own files of it. With no FROM, NAME goes.
# shellcheck disable=SC2317,SC2329
into_place() {
  no_link "$1" "$LAB_DATA/$2"
  # shellcheck disable=SC2016
  as_lab /bin/sh -c 'set -e; rm -rf "$2-wal" "$2-shm" "$3"; if [ -f "$1" ]; then mv -f "$1" "$2"; else rm -f "$2"; fi' into-place "$1" "$LAB_DATA/$2" "$LAB_DATA/.$2-litestream"
}

# restore_in_place BUILD [WHY]: the copies restore_beside made take the
# place of the databases, both renamed; Litestream starts on them with
# nothing of its own kept, so that it sends them whole.
# shellcheck disable=SC2317,SC2329
restore_in_place() {
  local name
  for name in $LAB_DATABASES; do
    into_place "$LAB_DATA/$name.restored" "$name" || fail "$name could not be put in place${2:+: $2}"
    if [[ -f $BEFORE_DEPLOY/$1/$name ]]; then
      say "put $name back as it was before the Deploy of $1"
    else
      say "removed $name: there was none before the Deploy of $1"
    fi
  done
  # A Litestream that does not start again fails the Deploy on its way out.
  litestream_up || true
}

# switch_to TAG: stop labd, point the mini at that build, start labd from it
# under the build's own LaunchDaemon file, and have what else runs from the
# build start again: the Out-of-band controller and the Builder, which the
# set-up installs. The controller's file is in place before the first
# Deploy, with no build to run it from: then it is started here, so that
# labd, which holds its token, finds it answering. cloudflared reads its
# routes from the build when it starts, so it is restarted when they are
# other routes.
switch_to() {
  local routes=0 label fresh=""
  if tunnel_installed && ! cmp -s "$LAB_CURRENT/deploy/cloudflared.yml" "$LAB_BUILDS/$1/deploy/cloudflared.yml"; then routes=1; fi
  stop_labd
  ln -sfn "builds/$1" "$LAB_CURRENT"
  touch "$LAB_BUILDS/$1"
  cp "$LAB_BUILDS/$1/deploy/$LABD_LABEL.plist" "$plist"
  chown "$ROOT_OWNER:$ROOT_GROUP" "$plist"
  chmod 0644 "$plist"
  launchctl enable "system/$LABD_LABEL" || true
  launchctl bootstrap system "$plist" || say "launchd did not take $plist"
  if ! loaded "$OOBD_LABEL" && [[ -f $OOBD_PLIST ]]; then
    fresh="$OOBD_LABEL"
    launchctl enable "system/$OOBD_LABEL" || true
    if launchctl bootstrap system "$OOBD_PLIST" && loaded "$OOBD_LABEL"; then
      say "started $OOBD_LABEL from the build of $1"
    else
      say "launchd did not start $OOBD_LABEL from $OOBD_PLIST: see /var/log/oobd.log"
    fi
  fi
  for label in "$OOBD_LABEL" "$BUILDER_LABEL"; do
    [[ $label != "$fresh" ]] || continue
    loaded "$label" || continue
    if launchctl kickstart -k "system/$label"; then
      say "restarted $label from the build of $1"
    else
      say "launchd did not restart $label"
    fi
  done
  if (( routes )) && loaded "$CLOUDFLARED_LABEL"; then
    if launchctl kickstart -k "system/$CLOUDFLARED_LABEL"; then
      say "restarted the tunnel: the build of $1 has other routes"
    elif (( switching )); then
      fail "launchd did not restart the tunnel, and the build of $1 has other routes"
    else
      say "launchd did not restart the tunnel: it keeps the routes it had"
    fi
  fi
}

answers() { [[ "$(curl -fsS --max-time 5 -A lab-deploy "$@" 2>/dev/null)" == ok ]]; }

# through_the_front_door: labd answers at the Lab address, by way of
# Cloudflare and the tunnel. True as well when no tunnel is installed here.
through_the_front_door() { ! tunnel_installed || answers "$FRONT_DOOR/healthz"; }

# verify: launchd runs labd, and it answers on its loopback port, on the
# tunnel's socket and through the Front door; then labd itself says that
# the Builder asks it for work and the Out-of-band controller answers it.
# A binary that cannot run on this machine fails here.
verify() {
  local n wrong=""
  for (( n = ${LAB_VERIFY_TRIES:-30}; n > 0; n-- )); do
    if loaded "$LABD_LABEL" && answers "http://$LABD_LISTEN/healthz" &&
      answers --unix-socket "$LABD_SOCKET" -H 'X-Forwarded-Proto: https' "http://$LAB_HOST/healthz" &&
      through_the_front_door; then
      break
    fi
    sleep 1
  done
  if (( n == 0 )); then
    loaded "$LABD_LABEL" || say "launchd does not have $LABD_LABEL loaded"
    through_the_front_door || say "labd does not answer through the Front door ($FRONT_DOOR/healthz)"
    answers "http://$LABD_LISTEN/healthz" || say "labd does not answer at http://$LABD_LISTEN/healthz"
    answers --unix-socket "$LABD_SOCKET" -H 'X-Forwarded-Proto: https' "http://$LAB_HOST/healthz" || say "labd does not answer on $LABD_SOCKET"
    if [[ -f $LABD_LOG ]]; then
      say "the end of $LABD_LOG:"
      as_lab tail -n 20 "$LABD_LOG" | sed 's/^/    /'
    fi
    return 1
  fi
  # The Builder asks labd for work once container's server answers it.
  for (( n = ${LAB_PARTS_TRIES:-90}; n > 0; n-- )); do
    wrong="$(parts_bad)"
    [[ -n $wrong ]] || return 0
    sleep 1
  done
  say "labd answers, and $(tr '\n' ';' <<<"$wrong" | sed 's/;$//; s/;/; /g')"
  return 1
}

# way_back: the build that was running runs again, or, with none before it,
# labd stays stopped. Leaving a release with no way back, the databases go
# back with it. It always ends the Deploy as failed.
# shellcheck disable=SC2317,SC2329
way_back() {
  local lost="" name
  switching=0 announced=0
  if (( went_back )) && [[ -d $BEFORE_DEPLOY/$tag ]]; then
    # The copy this Deploy made of them is renamed back, not copied: a disk
    # that filled on the way does not stop it.
    went_back=0
    stop_labd
    say "the databases go back as $previous had them"
    no_link "$BEFORE_DEPLOY" "$BEFORE_DEPLOY/$tag"
    litestream_down "the lab is Dark"
    for name in $LAB_DATABASES; do
      into_place "$BEFORE_DEPLOY/$tag/$name" "$name" || fail "$name could not be put back from $BEFORE_DEPLOY/$tag: the lab is Dark"
    done
    litestream_up || true
    lost=" The databases are as $previous had them."
  elif [[ -f $LAB_BUILDS/$tag/deploy/no-way-back && -d $BEFORE_DEPLOY/$tag && "$(running)" == "$tag" ]]; then
    stop_labd
    say "$tag says \"No way back.\": the databases go back as they were before it"
    restore_beside "$tag" "the lab is Dark, with $tag's databases in place"
    restore_in_place "$tag" "the lab is Dark"
    lost=" The databases are as they were before it: what arrived since is lost."
  fi
  if [[ -n $previous ]]; then
    switch_to "$previous"
    rm -rf "${LAB_BUILDS:?}/$tag"
    if ! verify; then
      tell "Deploy of $tag on the mini failed its check, and $previous, put back, does not answer either: the lab is Dark.$lost"
      fail "$tag was not Deployed, and $previous, put back, does not answer either: the lab is Dark"
    fi
    tell "Deploy of $tag on the mini failed its check: $previous is back and answers.$lost"
    fail "$tag was not Deployed: $previous is back and answers"
  fi
  stop_labd
  # The controller runs from the build, whoever loaded it: this Deploy, or
  # launchd at boot from the file the set-up installed. While it runs, the
  # build stays.
  if ! stopped "$OOBD_LABEL"; then
    say "$OOBD_LABEL did not stop (20 s)"
    rm -f "$plist"
    tell "Deploy of $tag on the mini failed its check. There was no build before it, so labd is stopped; $OOBD_LABEL did not stop, so its build stays at $LAB_BUILDS/$tag: the way back is incomplete.$lost"
    fail "$tag was not Deployed, and $OOBD_LABEL did not stop: the way back is incomplete. Stop it (sudo launchctl bootout system/$OOBD_LABEL), then remove $LAB_CURRENT and $LAB_BUILDS/$tag"
  fi
  rm -f "$LAB_CURRENT" "$plist"
  rm -rf "${LAB_BUILDS:?}/$tag"
  tell "Deploy of $tag on the mini failed its check. There was no build before it, so labd is stopped.$lost"
  fail "$tag was not Deployed: there was no build before it, so labd is stopped"
}

# The last three builds stay; the running one always does. A build's copy of
# the databases goes with it.
prune() {
  local n=0 b now
  now="$(running)"
  # shellcheck disable=SC2012
  ls -1t "$LAB_BUILDS" | while read -r b; do
    n=$((n + 1))
    if (( n > 3 )) && [[ $b != "$now" ]]; then
      rm -rf "${LAB_BUILDS:?}/$b"
      say "removed the build $b: the last three are kept"
    fi
  done
  [[ -d $BEFORE_DEPLOY && ! -L $BEFORE_DEPLOY ]] || return 0
  # shellcheck disable=SC2012
  ls -1 "$BEFORE_DEPLOY" | while read -r b; do
    [[ $b =~ $RELEASE_TAG && ! -d $LAB_BUILDS/$b ]] || continue
    as_lab rm -rf "${BEFORE_DEPLOY:?}/$b"
  done
}

# older A B: release A comes before release B; an rc before its release.
older() {
  local a b i x y
  IFS=.- read -r -a a <<<"${1#v}"
  IFS=.- read -r -a b <<<"${2#v}"
  for i in 0 1 2; do
    x="${a[i]}" y="${b[i]}"
    (( 10#$x == 10#$y )) || { (( 10#$x < 10#$y )); return; }
  done
  x="${a[4]:-}" y="${b[4]:-}"
  [[ -n $x ]] || return 1
  [[ -n $y ]] || return 0
  (( 10#$x < 10#$y ))
}

# Set when this Deploy goes back from a running release that says "No way
# back." and the databases from before it are kept.
going_back=0
# decide: what runs now, and whether this Deploy goes back from it.
decide() {
  previous="$(running)"
  going_back=0
  if [[ -n $previous && -f $LAB_BUILDS/$previous/deploy/no-way-back ]] && older "$tag" "$previous"; then
    # Without that copy the older labd would start on databases only the
    # marked release reads: refused while labd still runs.
    [[ -d $BEFORE_DEPLOY/$previous && ! -L $BEFORE_DEPLOY/$previous ]] ||
      fail "$previous says \"No way back.\", and there is no copy of the databases from before it ($BEFORE_DEPLOY/$previous): $tag would start on databases only $previous reads. Nothing was changed, and $previous still runs"
    going_back=1
  fi
}
decide
if [[ $previous == "$tag" ]]; then
  if verify; then
    say "$tag is already the running build, and labd answers"
    exit 0
  fi
  fail "$tag is already the running build, and labd does not answer: Deploy another version"
fi

fetch "$from/$RELEASE_BUNDLE" "$work/$RELEASE_BUNDLE" || fail "could not download $from/$RELEASE_BUNDLE"
fetch "$from/$RELEASE_BUNDLE.sig" "$work/$RELEASE_BUNDLE.sig" || fail "could not download $from/$RELEASE_BUNDLE.sig: a bundle with no signature is not installed"
verified "$work/$RELEASE_BUNDLE" || fail "$RELEASE_BUNDLE does not match its signature by the release key pinned on this machine ($LAB_SIGNERS): nothing was changed"
say "$RELEASE_BUNDLE matches its signature by the pinned release key"

if (( DRY )); then
  stage="$work/unpacked"
else
  no_planted_link
  no_link "$BEFORE_DEPLOY"
  mkdir -p "$LAB_BUILDS"
  mkdir "$LAB_ROOT/.deploying" 2>/dev/null || fail "another Deploy is running ($LAB_ROOT/.deploying)"
  lock="$LAB_ROOT/.deploying"
  # Another Deploy may have ended since the first look.
  decide
  [[ $previous != "$tag" ]] || fail "$tag became the running build while this Deploy downloaded it: nothing was changed"
  if loaded "$LITESTREAM_LABEL"; then litestream_ran=1; fi
  rm -rf "$LAB_BUILDS"/.incoming.*
  stage="$LAB_BUILDS/.incoming.$$"
fi
mkdir "$stage"
tar -xpzf "$work/$RELEASE_BUNDLE" -C "$stage" --no-same-owner
new="$stage/lab-server"
[[ -f $new/VERSION ]] || fail "the bundle has no VERSION"
[[ "$(<"$new/VERSION")" == "$tag" ]] || fail "the bundle is $(<"$new/VERSION"), not $tag: nothing was changed"
[[ -x $new/bin/labd ]] || fail "the bundle has no bin/labd"
[[ -f $new/deploy/$LABD_LABEL.plist ]] || fail "the bundle has no LaunchDaemon file for labd"
[[ -f $new/deploy/cloudflared.yml ]] || fail "the bundle has no route file for the tunnel"

if tunnel_installed; then
  where="on its loopback port, on its socket and through the Front door"
else
  where="on its loopback port and its socket; the tunnel is not installed on this machine, so the Front door was not asked"
fi

if (( DRY )); then
  say "would unpack $tag to $LAB_BUILDS/$tag"
  say "would tell \"Agents\" and drain jobs, waiting up to $wait minutes for those that run"
  say "would stop labd and copy $LAB_DATABASES to $BEFORE_DEPLOY/$tag"
  say "would switch $LAB_CURRENT from ${previous:-nothing} to $tag"
  say "would restart $LABD_LABEL under $plist, $OOBD_LABEL and $BUILDER_LABEL where they are loaded, and start $OOBD_LABEL where it is installed and not loaded: never the mini, and no tool"
  say "would verify labd at http://$LABD_LISTEN/healthz and on $LABD_SOCKET, and put ${previous:-nothing} back if it does not answer"
  if tunnel_installed; then
    say "would verify labd through the Front door at $FRONT_DOOR/healthz as well"
  else
    say "would not ask the Front door: the tunnel is not installed on this machine"
  fi
  say "would ask labd whether the Builder asks it for work and the Out-of-band controller answers"
  if [[ -f $new/deploy/no-way-back ]]; then
    say "$tag says \"No way back.\": going back from it would put the databases back as they were before it"
  fi
  if (( going_back )); then
    say "$previous says \"No way back.\": would put the databases back as they were before $previous, after the copy; what arrived since would be lost"
  fi
  exit 0
fi

chown -Rh "$ROOT_OWNER:$ROOT_GROUP" "$new"
chmod -R ug-s,go-w "$new"
rm -rf "${LAB_BUILDS:?}/$tag"
mv "$new" "$LAB_BUILDS/$tag"
say "unpacked $tag to $LAB_BUILDS/$tag"

announced=1
tell "Deploy of $tag on the mini: started${previous:+, from $previous}. Jobs are drained, then the lab's services restart; the mini does not."
if ! drain_jobs "$wait"; then
  announced=0
  rm -rf "${LAB_BUILDS:?}/$tag"
  tell "Deploy of $tag on the mini did not go on: $NOT_DRAINED. Nothing was switched, and jobs start again."
  fail "$NOT_DRAINED. Nothing was switched"
fi

switching=1
stop_labd
snapshot
lost=""
if (( going_back )); then
  say "$previous says \"No way back.\": the databases go back as they were before it"
  restore_beside "$previous"
  went_back=1
  restore_in_place "$previous"
  lost=" $previous says \"No way back.\": the databases are as they were before $previous, and what arrived since is lost."
fi
switch_to "$tag"
if verify; then
  switching=0
  went_back=0
  DRAINING=0
  prune
  behind=""
  if [[ -n "$(builder_behind "$LAB_CURRENT")" ]]; then
    behind=" The Builder still runs the images it had: run sudo $LAB_CURRENT/scripts/mini/setup to build the Builder's new images and start it with them."
    builder_behind "$LAB_CURRENT" | while IFS= read -r line; do say "$line"; done
  fi
  tell "Deployed $tag on the mini: labd answers $where; the Builder and the Out-of-band controller are as labd expects.${previous:+ $previous is kept as the way back.}$lost$behind"
  exit 0
fi

say "labd of $tag failed its check"
way_back
