if [[ -n $NOT_KEYS_ONLY ]]; then
  fail "$CHANGES changes made, and one thing is not as it should be: $NOT_KEYS_ONLY"
elif (( CHANGES == 0 )); then
  say "nothing to change"
elif (( DRY )); then
  say "$CHANGES changes would be made; nothing was changed"
else
  say "$CHANGES changes made"
fi
