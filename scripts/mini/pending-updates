#!/bin/bash
# What waits for a Maintenance run on the mini, a line for each:
#
#   scripts/mini/pending-updates
#
#   macOS: macOS Tahoe 26.1.1-25B80       an update Software Update lists
#   cloudflared 2026.10.1 -> 2026.11.0    a Homebrew tool of the lab with a newer version
#
# and nothing when nothing waits. labd runs it for the weekly digest, as
# the lab account. It installs nothing and runs no Homebrew: a tool's
# version here is the one of the copy the daemons run from, and its newest
# is read from the list Homebrew publishes, or for a tap's formula from the
# tap's own file. What could not be asked is a line too, so that a digest
# with no update in it always means that none waits.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
# Run by hand as the lab account from where the admin stands, often a home
# that account cannot read, every command it starts would say so.
cd / 2>/dev/null
# shellcheck source=scripts/mini/lib.sh
. "$here/lib.sh"

[[ $# == 0 ]] || { sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# limited SECONDS COMMAND...: the command, stopped when it takes longer.
limited() {
  local limit="$1" pid watcher status=0
  shift
  "$@" &
  pid=$!
  ( sleep "$limit"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  watcher=$!
  wait "$pid" || status=$?
  kill "$watcher" 2>/dev/null || true
  return "$status"
}

if out="$(limited "${LAB_UPDATE_LIMIT:-150}" softwareupdate --list 2>&1)"; then
  sed -n 's/^[[:space:]]*\* Label: \(.*[^[:space:]]\)[[:space:]]*$/macOS: \1/p' <<<"$out"
else
  echo "macOS: Software Update did not answer"
fi

word='[0-9A-Za-z][0-9A-Za-z._+-]*'

# core_version NAME: the newest version of a formula of Homebrew's own, as a
# keg is named: the version, and _N for a revision.
core_version() {
  local json stable revision
  json="$(curl -fsS --max-time 20 "$FORMULA_LIST/$1.json" 2>/dev/null)" || return 0
  stable="$(plutil -extract versions.stable raw -o - - <<<"$json" 2>/dev/null)" || return 0
  revision="$(plutil -extract revision raw -o - - <<<"$json" 2>/dev/null)" || revision=0
  [[ $stable =~ ^$word$ ]] || return 0
  if [[ $revision =~ ^[1-9][0-9]*$ ]]; then echo "${stable}_$revision"; else echo "$stable"; fi
}

# tap_version USER TAP NAME: the version a tap's formula file states.
tap_version() {
  local at file
  for at in "$3.rb" "Formula/$3.rb"; do
    file="$(curl -fsS --max-time 20 "$TAP_FILES/$1/homebrew-$2/HEAD/$at" 2>/dev/null)" || continue
    sed -n "s/^[[:space:]]*version \"\\($word\\)\".*/\\1/p" <<<"$file" | head -n 1
    return 0
  done
}

list="$(cd "$here/../.." && pwd)/deploy/homebrew-formulae"
versions="$LAB_TOOLS/current/VERSIONS"
[[ -f $list && -f $versions ]] || exit 0
while read -r formula; do
  name="${formula##*/}"
  [[ $formula =~ ^($word/$word/)?$word$ ]] || continue
  have="$(awk -v n="$name" '$1 == n { print $2; exit }' "$versions")"
  [[ -n $have ]] || continue
  if [[ $formula == */* ]]; then
    IFS=/ read -r user tap _ <<<"$formula"
    newest="$(tap_version "$user" "$tap" "$name")"
  else
    newest="$(core_version "$name")"
  fi
  if [[ -z $newest ]]; then
    echo "$name: its newest version could not be read"
  elif [[ $newest != "$have" ]]; then
    echo "$name $have -> $newest"
  fi
done < <(sed -e 's/#.*//' "$list" | awk 'NF { print $1 }')
