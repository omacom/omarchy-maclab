# The Homebrew formulae the lab's daemons on the mini come from, one a line.
# scripts/mini/setup installs each as the account /opt/homebrew belongs to,
# then copies it and what it needs to run into /usr/local/lab/tools, which
# only root can write. A LaunchDaemon file names the copy
# (/usr/local/lab/tools/current/<formula>/bin/<tool>), never /opt/homebrew.
# Versions follow Homebrew and change only in a Maintenance run.

cloudflared   # the tunnel: deploy/org.omarchy-mac.lab.cloudflared.plist

# The tailnet: tailscaled, the open-source daemon, and its command. It takes
# the place of the Tailscale Standalone app, under the lab's own
# deploy/org.omarchy-mac.lab.tailscaled.plist: never Homebrew's service, never
# tailscaled install-system-daemon.
tailscale

# The lab's Signal sender. Homebrew builds it as one native program, with no
# Java beside it; should it need one again, the set-up copies that too.
signal-cli

# Backups. Litestream is a tap's formula: Homebrew core has none.
benbjohnson/litestream/litestream   # both databases to the house, a second behind: deploy/org.omarchy-mac.lab.litestream.plist
restic        # the nightly backup: deploy/org.omarchy-mac.lab.backup.plist

# Not qrencode: its program loads libpng from /opt/homebrew, so the copy would
# refuse it. scripts/mini/signal link has the Deployed labd draw the QR code
# (labd qr), and uses no qrencode at all.
